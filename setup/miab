#!/bin/bash

## -- Start Environment Discovery -- ##
# Get the full path to the script, resolving symlinks
# ~/mailinabox/setup/miab
SCRIPT_FULL_PATH="$(readlink -f "$0")"

# Get the directory of the script
# ~/mailinabox/setup
SCRIPT_DIR="$(dirname "$SCRIPT_FULL_PATH")"
SETUP_DIR=$SCRIPT_DIR

# To get the parent directory of that directory (i.e., one level up)
# ~/mailinabox
PARENT_DIR="$(dirname "$SCRIPT_DIR")"
# ~/ or lets say /home/ubuntu/
MIAB_USER_DIR="$(dirname "$PARENT_DIR")"

# TODO: add some generic verification that we got cloned at last into
# a home folder under our original name ~/mailinabox. 
# eg: mailinabox

echo "Script Dir: $SCRIPT_DIR"
echo "Parent Dir: $PARENT_DIR"
echo "HOME: $MIAB_USER_DIR" 
echo "PREV_PWD: $PWD" 
## we should be here /home/MIAB_USER_DIR/mailinabox
cd $PARENT_DIR
echo "PWD: $PWD"

## uv gets installed here and all user local bins
if [ ! -d $MIAB_USER_DIR/.local/bin ]; then
    mkdir -p $MIAB_USER_DIR/.local/bin
fi

if echo "$PATH" | grep -q "$MIAB_USER_DIR/.local/bin"; then
    echo "✅ $MIAB_USER_DIR/.local/bin is in the PATH."
else
    source $MIAB_USER_DIR/.bashrc
    source $MIAB_USER_DIR/.profile
    if echo "$PATH" | grep -q "$MIAB_USER_DIR/.local/bin"; then
        echo "✅ $MIAB_USER_DIR/.local/bin is in the PATH."
    else
        echo "❌ $MIAB_USER_DIR/.local/bin is NOT in the PATH."
        exit 1
    fi
fi

if [ ! -f $MIAB_USER_DIR/.local/bin(mailinabox ]; then
    ln -s $SCRIPT_DIR/start.sh $MIAB_USER_DIR/.local/bin/mailinabox
    chmod +x $MIAB_USER_DIR/.local/bin/mailinabox
fi

# Put a start script in a global location. We tell the user to run 'mailinabox'
# in the first dialog prompt, so we should do this before that starts.
# cat > /usr/local/bin/mailinabox << EOF;
# #!/bin/bash
# cd $PARENT_DIR
# source $SCRIPT_DIR/start.sh
# EOF

## End of Environment Discovery.

# --- Input Validation ---
if [ -z "$1" ]; then
    echo "ERROR: Please supply a command or a valid path to a file." >&2
    exit 1
fi

COMMAND_OR_FILE="$1"

# --- EXECUTION LOGIC ---

EXECUTION_EXIT_CODE=0
ACTION=""

# 1. Check for 'pip' commands
if [[ "$COMMAND_OR_FILE" == pip* ]]; then
    
    ACTION="uv pip"
    echo "Detected 'pip' command. Executing via uv pip..."
    
    # We pass the full command line argument list starting from $1
    # Example: If called as './wrapper.sh pip install requests', this runs 'uv pip install requests'
    uv pip "$@"
    EXECUTION_EXIT_CODE=$?

# 2. Check for Python files (.py)
elif [ -f "$COMMAND_OR_FILE" ] && [[ "$COMMAND_OR_FILE" =~ \.py$ ]]; then
    
    ACTION="uv run"
    echo "Detected Python script (.py). Executing via uv run..."
    
    # We execute the script using uv run. Note: $1 is the path, $2, $3, etc. are args for the script.
    uv run "$@"
    EXECUTION_EXIT_CODE=$?

# 3. Check for sourceable files (All other existing files)
elif [ -f "$COMMAND_OR_FILE" ]; then
    
    ACTION="Sourcing"
    echo "Detected non-Python script. Sourcing script: '$COMMAND_OR_FILE'..."
    
    # Execute the script in the current shell context.
    source "$COMMAND_OR_FILE"
    EXECUTION_EXIT_CODE=$?

# 4. Handle invalid input (Non-file, non-pip command)
else
    echo "ERROR: Input '$COMMAND_OR_FILE' is not a known 'pip' command or a valid file path." >&2
    exit 1
fi

# --- Final Status Check ---

if [ "$EXECUTION_EXIT_CODE" -eq 0 ]; then
    echo "Successfully executed ($ACTION)."
else
    echo "ERROR: $ACTION failed. Execution exited with non-zero status ($EXECUTION_EXIT_CODE)." >&2
    exit "$EXECUTION_EXIT_CODE"
fi
