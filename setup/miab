#!/bin/bash

# --- UTF-8 Icons for Status ---
ICON_SUCCESS="✅"
ICON_FAILURE="❌"
ICON_INFO="ℹ️"
ICON_COMMAND="🚀"
ICON_FILE="📄"
ICON_DIR="📁"

# --- Function to Safely Read Shebang ---
get_shebang_interpreter() {
    local file="$1"
    local shebang_line=$(head -n 1 "$file" 2>/dev/null)
    
    if [[ "$shebang_line" =~ ^#\! ]]; then
        echo "$shebang_line" | awk '{print $NF}' | xargs basename
    fi
}

# ==============================================================================
# 1. ENVIRONMENT DISCOVERY AND SETUP (MIAB SPECIFIC)
# ==============================================================================

echo "$ICON_INFO Starting Environment Discovery and Setup..."

# Get location variables
SCRIPT_FULL_PATH="$(readlink -f "$0" || exit 1)"
SCRIPT_DIR="$(dirname "$SCRIPT_FULL_PATH")"
SETUP_DIR="$SCRIPT_DIR"

# Assuming structure is /home/user/mailinabox/management/this_script.sh
PARENT_DIR="$(dirname "$SCRIPT_DIR")"
MIAB_USER_DIR="$(dirname "$PARENT_DIR")"

echo "$ICON_DIR Script Dir: $SCRIPT_DIR"
echo "$ICON_DIR Project Root (PARENT_DIR): $PARENT_DIR"
echo "$ICON_DIR User Home (MIAB_USER_DIR): $MIAB_USER_DIR"
echo "$ICON_INFO Current PWD: $PWD"

# Change directory to the project root (essential for relative paths and uv)
if ! cd "$PARENT_DIR"; then
    echo "$ICON_FAILURE FATAL: Could not change directory to $PARENT_DIR." >&2
    exit 1
fi
echo "$ICON_SUCCESS PWD set to: $PWD"

# Ensure .local/bin exists in the user's home directory
if [ ! -d "$MIAB_USER_DIR/.local/bin" ]; then
    echo "$ICON_INFO Creating $MIAB_USER_DIR/.local/bin..."
    if ! mkdir -p "$MIAB_USER_DIR/.local/bin"; then
        echo "$ICON_FAILURE FATAL: Could not create $MIAB_USER_DIR/.local/bin." >&2
        exit 1
    fi
fi

# Check and fix PATH environment variable
PATH_TO_CHECK="$MIAB_USER_DIR/.local/bin"

if echo "$PATH" | grep -q "$PATH_TO_CHECK"; then
    echo "$ICON_SUCCESS $PATH_TO_CHECK is in the PATH."
else
    echo "$ICON_INFO Attempting to fix PATH via sourcing .bashrc and .profile..."
    
    if [ -f "$MIAB_USER_DIR/.bashrc" ]; then
        source "$MIAB_USER_DIR/.bashrc" || true
    fi
    if [ -f "$MIAB_USER_DIR/.profile" ]; then
        source "$MIAB_USER_DIR/.profile" || true
    fi

    if echo "$PATH" | grep -q "$PATH_TO_CHECK"; then
        echo "$ICON_SUCCESS PATH successfully updated."
    else
        echo "$ICON_FAILURE FATAL: $PATH_TO_CHECK is NOT in the PATH after sourcing." >&2
        exit 1
    fi
fi

# ----------------------------------------------------------------------
# Create Symlink 1: mailinabox (points to start.sh)
# ----------------------------------------------------------------------
TARGET_LINK_MAILINABOX="$MIAB_USER_DIR/.local/bin/mailinabox"
SOURCE_SCRIPT_START="$SCRIPT_DIR/start.sh"

if [ ! -L "$TARGET_LINK_MAILINABOX" ]; then
    echo "$ICON_INFO Creating symlink 'mailinabox' -> $SOURCE_SCRIPT_START"
    if [ -f "$SOURCE_SCRIPT_START" ]; then
        if ! ln -s "$SOURCE_SCRIPT_START" "$TARGET_LINK_MAILINABOX"; then
            echo "$ICON_FAILURE WARNING: Failed to create symlink $TARGET_LINK_MAILINABOX." >&2
        else
            chmod +x "$TARGET_LINK_MAILINABOX"
            echo "$ICON_SUCCESS Symlink 'mailinabox' created and executable."
        fi
    else
        echo "$ICON_FAILURE WARNING: Source script $SOURCE_SCRIPT_START not found. Skipping 'mailinabox' link." >&2
    fi
fi


# ----------------------------------------------------------------------
# Create Symlink 2: miab (points to the current wrapper script)
# ----------------------------------------------------------------------
TARGET_LINK_MIAB="$MIAB_USER_DIR/.local/bin/miab"
SOURCE_SCRIPT_WRAPPER="$SCRIPT_FULL_PATH"

if [ ! -L "$TARGET_LINK_MIAB" ]; then
    echo "$ICON_INFO Creating CLI symlink 'miab' -> $SOURCE_SCRIPT_WRAPPER"
    if ! ln -s "$SOURCE_SCRIPT_WRAPPER" "$TARGET_LINK_MIAB"; then
        echo "$ICON_FAILURE WARNING: Failed to create CLI symlink $TARGET_LINK_MIAB." >&2
    else
        chmod +x "$TARGET_LINK_MIAB"
        echo "$ICON_SUCCESS CLI symlink 'miab' created and executable."
    fi
fi


# ==============================================================================
# 2. COMMAND EXECUTION LOGIC
# ==============================================================================

COMMAND_OR_FILE="$1"

# 1. Check for 'pip' commands
if [[ "$COMMAND_OR_FILE" == pip* ]]; then
    
    ACTION="uv pip"
    echo "$ICON_COMMAND Detected 'pip' command. Executing via $ACTION..."
    uv pip "$@"
    EXECUTION_EXIT_CODE=$?

# 2. Handle files that exist
elif [ -f "$COMMAND_OR_FILE" ]; then

    # --- A. Check common extensions ---
    
    # Python Extensions (.py)
    if [[ "$COMMAND_OR_FILE" =~ \.py$ ]]; then
        ACTION="uv run (.py extension)"
        echo "$ICON_FILE Detected Python script (.py). Executing via $ACTION..."
        uv run "$@"
        EXECUTION_EXIT_CODE=$?

    # JavaScript Extensions (.js, .mjs, .cjs)
    elif [[ "$COMMAND_OR_FILE" =~ \.(m|c)?js$ ]]; then
        ACTION="node execution (JavaScript extension)"
        echo "$ICON_FILE Detected JavaScript file. Executing via node..."
        /usr/bin/env node "$@"
        EXECUTION_EXIT_CODE=$?

    # TypeScript Extensions (.ts, .mts, .cts)
    elif [[ "$COMMAND_OR_FILE" =~ \.(m|c)?ts$ ]]; then
        ACTION="node execution (TypeScript extension)"
        echo "$ICON_FILE Detected TypeScript file. Executing via node with experimental flags..."
        
        /usr/bin/env node \
            --experimental-strip-types \
            --experimental-transform-types \
            "$@"
        
        EXECUTION_EXIT_CODE=$?
    
    # --- B. Check Shebang for files without recognized extensions ---
    else
        
        INTERPRETER=$(get_shebang_interpreter "$COMMAND_OR_FILE")

        case "$INTERPRETER" in
            bash|sh|zsh)
                ACTION="Sourcing ($INTERPRETER shebang)"
                echo "$ICON_INFO Detected shell script ($INTERPRETER shebang). Sourcing..."
                source "$COMMAND_OR_FILE"
                EXECUTION_EXIT_CODE=$?
                ;;

            python|python3)
                ACTION="uv run (Python shebang)"
                echo "$ICON_INFO Detected Python script (shebang). Executing via $ACTION..."
                uv run "$@"
                EXECUTION_EXIT_CODE=$?
                ;;
            
            node|nodejs)
                ACTION="node execution (Node shebang)"
                echo "$ICON_INFO Detected Node.js script (shebang). Executing directly..."
                /usr/bin/env node "$@"
                EXECUTION_EXIT_CODE=$?
                ;;

            *)
                # Fallback: Assume sourcing for environment setup
                ACTION="Sourcing (fallback)"
                echo "$ICON_INFO File has no recognized extension or shebang. Falling back to Sourcing..."
                source "$COMMAND_OR_FILE"
                EXECUTION_EXIT_CODE=$?
                ;;
        esac
    fi

# 3. Handle invalid input
else
    echo "$ICON_FAILURE ERROR: Input '$COMMAND_OR_FILE' is not a known 'pip' command or a valid file path." >&2
    exit 1
fi

# --- Final Status Check ---

if [ "$EXECUTION_EXIT_CODE" -eq 0 ]; then
    echo "$ICON_SUCCESS FINAL SUCCESS: $ACTION completed successfully."
else
    echo "$ICON_FAILURE FINAL FAILURE: $ACTION failed. Execution exited with status ($EXECUTION_EXIT_CODE)." >&2
    exit "$EXECUTION_EXIT_CODE"
fi
